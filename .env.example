# Required: JWT signing secret -- minimum 32 characters.
# The server throws on the first authenticated request if this is missing or short.
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional on Node: DB driver -- sqlite (default), postgres, mysql
# PIO_DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/spio_database

# Optional: custom SQLite path (default ./data/presets.sqlite)
# PIO_SQLITE_PATH=./data/presets.sqlite

# Optional: Redis. Used for the session/preset cache AND to make the auth rate
# limiter survive restarts and span processes.
# REDIS_URL=redis://localhost:6379

# CSP third-party origin allowlists (space or comma separated)
# CSP_SCRIPT_ORIGINS=https://analytics.example.com
# CSP_CONNECT_ORIGINS=https://api.example.com

# --- Serverless (Vercel) ---------------------------------------------------
# The adapter is selected automatically from the VERCEL env var, so no build
# command override is needed. But the filesystem there is read-only and
# ephemeral, so SQLite cannot be used:
#
#   SESSION_SECRET   required
#   DATABASE_URL     required -- postgres:// or mysql://
#   REDIS_URL        recommended, otherwise cache and rate limits are per-instance
#
# See docs/DEPLOYMENT.md -> "Production (Vercel)".
